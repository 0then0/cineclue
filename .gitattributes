# Normalize text in the repository and working tree across platforms.
* text=auto eol=lf

# Keep Windows command scripts usable if added later.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never apply line-ending conversion or text diffs to binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.avif binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.gz binary
